{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayer-int.example/agentic-review/schemas/findings-bundle.schema.json",
  "title": "AgenticReviewFindingsBundle",
  "description": "Artifact uploaded by the metrics job: list of normalized findings plus gate evaluation metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "repository", "head_sha", "findings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "description": "owner/repo"
    },
    "head_sha": {
      "type": "string",
      "minLength": 7
    },
    "pr_number": {
      "type": ["integer", "null"]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    }
  }
}
